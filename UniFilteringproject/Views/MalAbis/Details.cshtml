@model UniFilteringproject.Models.MalAbi

@{
    ViewData["Title"] = "Details";
}

<div class="container mt-4">
    <div class="card shadow-sm border-0 rounded-3">
        <div class="card-header bg-dark text-white p-3">
            <h4 class="mb-0"><i class="bi bi-info-circle-fill me-2"></i> Candidate Ability Details</h4>
        </div>
        <div class="card-body p-4">
            <dl class="row align-middle m-0">
                <dt class="col-sm-3 fw-bold text-secondary mb-3">Malshab Name</dt>
                <dd class="col-sm-9 mb-3">@Html.DisplayFor(model => model.malshab.Name)</dd>

                <dt class="col-sm-3 fw-bold text-secondary mb-3">Ability</dt>
                <!-- תיקון מ-Id ל-Name בשביל הבוחן -->
                <dd class="col-sm-9 mb-3">@Html.DisplayFor(model => model.ability.Name)</dd>

                <dt class="col-sm-3 fw-bold text-secondary mb-3">Skill Level</dt>
                <dd class="col-sm-9 mb-3">
                    <span class="badge bg-primary fs-6">@Html.DisplayFor(model => model.AbiLevel)</span>
                </dd>
            </dl>
        </div>
        <div class="card-footer bg-light p-3 d-flex justify-content-between">
            <a asp-action="Edit" asp-route-id="@Model?.Id" class="btn btn-warning px-4"><i class="bi bi-pencil-fill me-1"></i> Edit</a>
            <a asp-action="Index" class="btn btn-secondary px-4"><i class="bi bi-arrow-left me-1"></i> Back to List</a>
        </div>
    </div>
</div>
<div>
    <a asp-action="Edit" asp-route-id="@Model?.Id">Edit</a> |
    <a asp-action="Index">Back to List</a>
</div>
